generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContractType {
  FULL_MEMBER
  FAMILY_MEMBER
  PASSIVE_MEMBER
  YOUTH_MEMBER
  SEASON_CARD
  NONE
}

enum KeyType {
  NONE
  MAIN_CHANGING_COURTS
  MAIN_CHANGING_COURTS_CLUBROOM
}

model User {
  id               String           @id @default(cuid())
  name             String
  email            String           @unique
  phoneNumber      String?
  passwordHash     String?
  role             String           @default("USER")
  isActive         Boolean          @default(true)
  membershipType   String           @default("EXTERNAL")
  membershipStatus String           @default("VERIFIED")
  memberNumber     String?
  teamPlayerId     String?
  contractType     ContractType     @default(NONE)
  contractStartDate DateTime?
  contractEndDate  DateTime?
  annualFeeCents   Int?
  workHoursRequired Int?
  workHoursDone    Int              @default(0)
  contractNote     String?
  hasKey           Boolean          @default(false)
  keyType          KeyType          @default(NONE)
  keyIssuedAt      DateTime?
  keyReturnedAt    DateTime?
  keyNote          String?
  adminNote        String?
  lastLoginAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  bookings         Booking[]
  resetTokens      PasswordResetToken[]
  teamPlayer       TeamPlayer?      @relation(fields: [teamPlayerId], references: [id], onDelete: SetNull)
  teamPlayerLinks  UserTeamPlayer[]
  auditLogs        AuditLog[]
}

model Court {
  id        Int          @id @default(autoincrement())
  name      String       @unique
  isActive  Boolean      @default(true)
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  bookings  Booking[]
  slots     BookingSlot[]
  blocks    CourtBlock[]
}

model Booking {
  id               String        @id @default(cuid())
  userId           String?
  guestName        String?
  guestEmail       String?
  guestPhone       String?
  bookingCode      String?       @unique
  courtId          Int
  startTime        DateTime
  endTime          DateTime
  durationMinutes  Int
  status           String        @default("PENDING")
  paymentStatus    String        @default("PENDING")
  totalAmountCents Int           @default(0)
  expiresAt        DateTime?
  cancelReason     String?
  confirmationEmailSentAt DateTime?
  reminderEmailSentAt DateTime?
  lastEmailError   String?
  emailRetryCount  Int           @default(0)
  archivedAt       DateTime?
  guestDataAnonymizedAt DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  court            Court         @relation(fields: [courtId], references: [id], onDelete: Restrict)
  slots            BookingSlot[]
  payment          Payment?

  @@index([courtId, startTime, endTime])
  @@index([userId, startTime])
  @@index([status, expiresAt])
}

model BookingSlot {
  id        String   @id @default(cuid())
  bookingId String
  courtId   Int
  slotStart DateTime
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  court     Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@unique([courtId, slotStart])
  @@index([bookingId])
}

model Payment {
  id                String          @id @default(cuid())
  bookingId         String          @unique
  provider          String          @default("paypal")
  amountCents       Int
  currency          String          @default("eur")
  status            String          @default("PENDING")
  providerPaymentId String?         @unique
  providerSessionId String?         @unique
  providerRefundId  String?         @unique
  refundedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  booking           Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model PaymentEvent {
  id          String   @id @default(cuid())
  provider    String   @default("paypal")
  eventId     String   @unique
  eventType   String
  processedAt DateTime @default(now())
}

model Settings {
  id                        String   @id @default("default")
  externalHourlyRateCents   Int      @default(1800)
  openingHour               Int      @default(8)
  closingHour               Int      @default(21)
  slotDurationMinutes       Int      @default(30)
  maxBookingDurationMinutes Int      @default(120)
  cancellationDeadlineHours Int      @default(2)
  maxActiveBookingsPerUser  Int      @default(3)
  maxAdvanceBookingDaysMember Int    @default(7)
  maxAdvanceBookingDaysGuest  Int    @default(3)
  guestDataRetentionDays      Int    @default(180)
  reminderHoursBefore         Int    @default(24)
  matchBlockDurationHours     Int    @default(6)
  matchBlockDefaultStartTime  String @default("09:00")
  matchBlockCourtIds          String @default("1,2,3,4")
  matchBlockBufferBeforeMinutes Int  @default(0)
  matchBlockBufferAfterMinutes  Int  @default(30)
  cancellationRules         String   @default("Kostenfreie Stornierung bis 24 Stunden vor Spielbeginn.")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  details     Json?
  ipAddress   String?
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model CourtBlock {
  id        String   @id @default(cuid())
  courtId   Int
  title     String
  reason    String?
  startTime DateTime
  endTime   DateTime
  createdAt DateTime @default(now())
  court     Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@index([courtId, startTime, endTime])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Team {
  id             String       @id @default(cuid())
  name           String
  season         String?
  source         String
  sourceUrl      String
  externalId     String?
  lastImportedAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  players        TeamPlayer[]
  matches        TeamMatch[]

  @@unique([source, sourceUrl])
  @@index([source, externalId])
}

model TeamMatch {
  id           String   @id @default(cuid())
  teamId       String
  season       String?
  date         DateTime
  startTime    DateTime
  endTime      DateTime?
  homeTeam     String
  awayTeam     String
  opponent     String?
  isHomeMatch  Boolean  @default(false)
  venue        String?
  league       String?
  groupName    String?
  sourceUrl    String
  importKey    String   @unique
  rawData      Json?
  importStatus String   @default("IMPORTED")
  blockStatus  String   @default("NONE")
  blockId      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, date])
  @@index([isHomeMatch, blockStatus])
}

model TeamPlayer {
  id             String   @id @default(cuid())
  teamId         String
  rank           Int?
  position       String?
  teamPosition   String?
  lk             String?
  nuLigaId       String?
  firstName      String
  lastName       String
  fullName       String
  birthYear      Int?
  nation         String?
  licenseNumber  String?
  info           String?
  msg            String?
  isCaptain      Boolean  @default(false)
  isActive       Boolean  @default(true)
  sourceUrl      String
  importKey      String   @unique
  rawData        Json?
  lastImportedAt DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  team           Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  linkedUsers    User[]
  userLinks      UserTeamPlayer[]

  @@index([teamId])
  @@index([fullName])
  @@index([nuLigaId])
  @@index([licenseNumber])
}

model UserTeamPlayer {
  id           String     @id @default(cuid())
  userId       String
  teamPlayerId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamPlayer   TeamPlayer @relation(fields: [teamPlayerId], references: [id], onDelete: Cascade)

  @@unique([userId, teamPlayerId])
  @@index([userId])
  @@index([teamPlayerId])
}
