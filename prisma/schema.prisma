generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContractType {
  FULL_MEMBER
  FAMILY_MEMBER
  PASSIVE_MEMBER
  YOUTH_MEMBER
  SEASON_CARD
  NONE
}

enum KeyType {
  NONE
  MAIN_CHANGING_COURTS
  MAIN_CHANGING_COURTS_CLUBROOM
}

model User {
  id               String           @id @default(cuid())
  name             String
  email            String           @unique
  phoneNumber      String?
  passwordHash     String?
  role             String           @default("USER")
  isActive         Boolean          @default(true)
  membershipType   String           @default("EXTERNAL")
  membershipStatus String           @default("VERIFIED")
  memberNumber     String?
  teamPlayerId     String?
  contractType     ContractType     @default(NONE)
  contractStartDate DateTime?
  contractEndDate  DateTime?
  annualFeeCents   Int?
  workHoursRequired Int?
  workHoursDone    Int              @default(0)
  contractNote     String?
  hasKey           Boolean          @default(false)
  keyType          KeyType          @default(NONE)
  keyIssuedAt      DateTime?
  keyReturnedAt    DateTime?
  keyNote          String?
  adminNote        String?
  lastLoginAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  bookings         Booking[]
  resetTokens      PasswordResetToken[]
  teamPlayer       TeamPlayer?      @relation(fields: [teamPlayerId], references: [id], onDelete: SetNull)
}

model Court {
  id        Int          @id @default(autoincrement())
  name      String       @unique
  isActive  Boolean      @default(true)
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  bookings  Booking[]
  slots     BookingSlot[]
  blocks    CourtBlock[]
}

model Booking {
  id               String        @id @default(cuid())
  userId           String
  courtId          Int
  startTime        DateTime
  endTime          DateTime
  durationMinutes  Int
  status           String        @default("PENDING")
  paymentStatus    String        @default("PENDING")
  totalAmountCents Int           @default(0)
  expiresAt        DateTime?
  cancelReason     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  court            Court         @relation(fields: [courtId], references: [id], onDelete: Restrict)
  slots            BookingSlot[]
  payment          Payment?

  @@index([courtId, startTime, endTime])
  @@index([userId, startTime])
  @@index([status, expiresAt])
}

model BookingSlot {
  id        String   @id @default(cuid())
  bookingId String
  courtId   Int
  slotStart DateTime
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  court     Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@unique([courtId, slotStart])
  @@index([bookingId])
}

model Payment {
  id                String          @id @default(cuid())
  bookingId         String          @unique
  provider          String          @default("stripe")
  amountCents       Int
  currency          String          @default("eur")
  status            String          @default("PENDING")
  providerPaymentId String?
  providerSessionId String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  booking           Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Settings {
  id                        String   @id @default("default")
  externalHourlyRateCents   Int      @default(1800)
  openingHour               Int      @default(8)
  closingHour               Int      @default(21)
  slotDurationMinutes       Int      @default(30)
  maxBookingDurationMinutes Int      @default(120)
  cancellationDeadlineHours Int      @default(2)
  maxActiveBookingsPerUser  Int      @default(3)
  maxAdvanceBookingDaysMember Int    @default(7)
  maxAdvanceBookingDaysGuest  Int    @default(3)
  cancellationRules         String   @default("Kostenfreie Stornierung bis 24 Stunden vor Spielbeginn.")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model CourtBlock {
  id        String   @id @default(cuid())
  courtId   Int
  title     String
  reason    String?
  startTime DateTime
  endTime   DateTime
  createdAt DateTime @default(now())
  court     Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@index([courtId, startTime, endTime])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Team {
  id             String       @id @default(cuid())
  name           String
  season         String?
  source         String
  sourceUrl      String
  externalId     String?
  lastImportedAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  players        TeamPlayer[]

  @@unique([source, sourceUrl])
  @@index([source, externalId])
}

model TeamPlayer {
  id             String   @id @default(cuid())
  teamId         String
  rank           Int?
  position       String?
  lk             String?
  nuLigaId       String?
  firstName      String
  lastName       String
  fullName       String
  birthYear      Int?
  licenseNumber  String?
  isCaptain      Boolean  @default(false)
  isActive       Boolean  @default(true)
  sourceUrl      String
  importKey      String   @unique
  rawData        Json?
  lastImportedAt DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  team           Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  linkedUsers    User[]

  @@index([teamId])
  @@index([fullName])
  @@index([nuLigaId])
  @@index([licenseNumber])
}
