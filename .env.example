# App
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=
AUTH_SECRET=ersetze-dies-durch-einen-langen-zufaelligen-wert
ADMIN_EMAILS=
EMBEDDED_COOKIE_MODE=false

# Datenbank: Neon/PostgreSQL fuer Vercel/Production.
# Die Neon-Verbindungszeichenfolge sollte sslmode=require enthalten.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# PayPal: sandbox fuer Entwicklung, live erst nach erfolgreichem Test.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# E-Mail fuer Passwort-Reset und Gast-Buchungsbestaetigung.
EMAIL_FROM="TV Europabad Marbach <noreply@deine-domain.de>"
RESEND_API_KEY=

# Verein
NEXT_PUBLIC_CLUB_NAME="TV Europabad Marbach"
